[Unit]
Description=bliti QR-anchored BLE device provisioning
After=bluetooth.service
Requires=bluetooth.service

[Service]
# bluetoothd must be configured peripheral-only for this to work at all, which
# is BLI-CHN, "The device is a peripheral only". Ship the two files next to this
# one: bliti-bluetoothd.conf and bliti-bluetooth-dropin.conf. The daemon cannot
# set this itself and BlueZ has no drop-in config directory, so it belongs in
# the device image alongside installing bluez.
#
# The daemon derives this board's sticker secret on its first start after
# imaging, and after a board change; every later start reads the cache. The
# derivation is memory-hard by design and wants 2 GiB, and the kernel kills it
# rather than failing it if that is not there, so deliberately no MemoryMax.
ExecStart=/usr/local/bin/bliti daemon
Restart=always
RestartSec=10s

# Runs as root: the board ID sources are root-readable only (the Pi's
# device-tree serial and its one-time-programmable memory), and the cache it
# writes holds the device's own secret. Creates /var/lib/bliti, which is where
# that cache lives by default.
StateDirectory=bliti

[Install]
WantedBy=multi-user.target
